    font-size: 1.05em;
  }
  .sobre-cred span::before {
    content: '·';
    margin-right: 8px;
  }
  .sobre-cred {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    color: var(--ink-2);
    font-size: 0.95rem;
    padding-bottom: 22px;
    margin-bottom: 22px;
    border-bottom: 1px solid var(--line-strong);
  }
  .sobre-card > p:not(.std-tag):not(.sobre-cred) {
    color: var(--ink-2);
    font-size: 1.08rem;
    max-width: 62ch;
  }
  .sobre-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .story {
    position: relative;
    border-radius: var(--r-xl);
    overflow: hidden;
    background: var(--dark);
    min-height: 520px;
    box-shadow: var(--shadow-lg);
  }
  .story-slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transition: opacity 0.9s var(--ease);
  }
  .story-slide.is-on {
    opacity: 1;
  }
  .story-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.06);
    transition: transform 5s linear;
  }
  .story-slide.is-on img {
    transform: scale(1);
  }
  .story-slide figcaption {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 22px;
    padding: 12px 16px;
    border-radius: var(--r-sm);
    background: rgba(30, 26, 21, 0.72);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.95rem;
  }
  .story-bars {
    position: absolute;
    top: 14px;
    left: 14px;
    right: 14px;
    z-index: 3;
    display: flex;
    gap: 5px;
  }
  .story-bars span {
    flex: 1;
    height: 3px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.35);
    overflow: hidden;
  }
  .story-bars i {
    display: block;
    height: 100%;
    width: 0;
    background: #fff;
  }
  .story-bars .is-done i {
    width: 100%;
  }
  .story-bars .is-active i {
    animation: bar 4.2s linear forwards;
  }
  @keyframes bar {
    to {
      width: 100%;
    }
  }
  .story-head {
    position: absolute;
    top: 30px;
    left: 16px;
    right: 16px;
    z-index: 3;
    display: grid;
    grid-template-columns: 40px 1fr;
    column-gap: 10px;
    color: #fff;
  }
  .story-head img {
    grid-row: span 2;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    object-fit: cover;
  }
  .story-name {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .story-name :global(svg) {
    color: var(--accent);
  }
  .story-meta {
    font-size: 0.8rem;
    opacity: 0.8;
  }
  .linha {
    list-style: none;
    padding: 0;
    margin: 64px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    position: relative;
  }
  .linha::before {
    content: '';
    position: absolute;
    top: 12px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--line-strong);
  }
  .linha li {
    position: relative;
    padding-top: 40px;
  }
  .linha li::before {
    content: '';
    position: absolute;
    top: 6px;
    left: 0;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 5px var(--bg), 0 0 0 6px var(--line-strong);
  }
  .linha-ano {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.3rem;
    color: var(--terra);
  }
  .linha h3 {
    font-size: 1.2rem;
    margin: 6px 0;
  }
  .linha p {
    font-size: 0.95rem;
    color: var(--ink-2);
    margin: 0;
  }

  /* ================= JORNADA ================= */
  .jornada {
    background: var(--surface);
    border-radius: var(--r-xl) var(--r-xl) 0 0;
  }
  .jor-grid {
    list-style: none;
    padding: 0;
    margin: 0 0 20px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .jor-card {
    padding: 28px;
    border-radius: var(--r-lg);
    background: var(--bg);
    border: 1px solid var(--line);
    transition: background 0.4s, transform 0.5s var(--ease);
  }
  .jor-card:hover {
    background: var(--accent-soft);
    transform: translateY(-4px);
  }
  .jor-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40px;
  }
  .jor-ico {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--accent);
  }
  .jor-num {
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--muted);
  }
  .jor-card h3 {
    font-size: 1.35rem;
    margin-bottom: 8px;
  }
  .jor-card p {
    color: var(--ink-2);
    margin: 0;
    font-size: 0.98rem;
  }
  .modos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .modo {
    padding: clamp(28px, 4vw, 44px);
    border-radius: var(--r-lg);
    background: var(--accent);
  }
  .modo-dark {
    background: var(--dark);
  }
  .modo-tag {
    display: inline-block;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.2rem;
    margin-bottom: 10px;
  }
  .modo-dark .modo-tag {
    color: var(--accent);
  }
  .modo h3 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }
  .modo p {
    max-width: 46ch;
    margin-bottom: 24px;
  }
  .modo-dark p {
    color: rgba(255, 255, 255, 0.72);
  }

  /* ================= DIFERENCIAIS ================= */
  .dif {
    background: var(--surface);
    padding-top: 0;
  }
  .dif-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .dif-item {
    border-bottom: 1px solid var(--line);
  }
  .dif-q {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 22px 0;
    background: none;
    border: 0;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .dif-ico {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    transition: background 0.4s, color 0.4s, border-color 0.4s;
  }
  .dif-item.is-open .dif-ico {
    background: var(--accent);
    border-color: var(--accent);
  }
  .dif-titulo {
    flex: 1;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }
  .dif-mark {
    position: relative;
    width: 14px;
    height: 14px;
  }
  .dif-mark::before,
  .dif-mark::after {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    width: 14px;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.4s var(--ease);
  }
  .dif-mark::after {
    transform: rotate(90deg);
  }
  .dif-item.is-open .dif-mark::after {
    transform: rotate(0);
  }
  .dif-a {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.55s var(--ease);
  }
  .dif-a > div {
    overflow: hidden;
  }
  .dif-item.is-open .dif-a {
    grid-template-rows: 1fr;
  }
  .dif-a p {
    color: var(--ink-2);
    padding: 0 0 22px 60px;
    margin: 0;
  }
  .dif-btn {
    margin-top: 32px;
  }
  .dif-figure {
    position: relative;
    border-radius: var(--r-xl);
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }
  .dif-slides {
    position: absolute;
    inset: 0;
  }
  .dif-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.06);
    transition: opacity 1.1s ease, transform 5.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .dif-slide.is-on {
    opacity: 1;
    transform: scale(1);
  }
  .dif-stat {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    border-radius: var(--r-md);
    background: rgba(250, 248, 245, 0.88);
    backdrop-filter: blur(14px);
  }
  .dif-stat strong {
    font-family: var(--font-display);
    font-size: 2.6rem;
    line-height: 1;
    letter-spacing: -0.05em;
  }
  .dif-stat span {
    font-size: 0.92rem;
    color: var(--ink-2);
  }

  /* ================= CONVERSAS ================= */
  .obj {
    position: relative;
    overflow: hidden;
    background: var(--dark);
    padding: clamp(90px, 12vw, 160px) 0;
  }
  .obj-fx {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .obj-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 64px 64px;
    -webkit-mask-image: radial-gradient(ellipse at center, #000 20%, transparent 75%);
    mask-image: radial-gradient(ellipse at center, #000 20%, transparent 75%);
  }
  @keyframes gridMove {
    to {
      background-position: 64px 64px;
    }
  }
  .obj-glow {
    position: absolute;
    width: 800px;
    height: 800px;
    border-radius: 50%;
    animation: float 14s ease-in-out infinite alternate;
    will-change: transform;
  }
  .obj-glow-1 {
    background: radial-gradient(circle, rgba(245, 196, 0, 0.28), transparent 65%);
    top: -320px;
    left: -280px;
  }
  .obj-glow-2 {
    background: radial-gradient(circle, rgba(182, 90, 54, 0.35), transparent 65%);
    bottom: -360px;
    right: -280px;
    animation-delay: -7s;
  }
  @keyframes float {
    to {
      transform: translate(80px, 60px) scale(1.1);
    }
  }
  .obj-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .obj-lines path {
    fill: none;
    stroke: rgba(245, 196, 0, 0.18);
    stroke-width: 1.2;
    stroke-dasharray: 8 10;
  }
  @keyframes dash {
    to {
      stroke-dashoffset: -600;
    }
  }
  .obj-inner {
    position: relative;
  }
  .chat {
    max-width: 760px;
    margin: 0 auto;
    display: grid;
    gap: 16px;
  }
  .msg {
    display: flex;
    gap: 12px;
    opacity: 0;
    transform: translateY(20px) scale(0.98);
    transition: opacity 0.7s var(--ease), transform 0.7s var(--ease);
  }
  .msg.is-in {
    opacity: 1;
    transform: none;
  }
  .msg-eu {
    justify-content: flex-end;
  }
  .bubble {
    max-width: 520px;
    padding: 14px 18px;
    border-radius: 14px 14px 4px 14px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.14);
    font-size: 1.02rem;
  }
  .msg-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    object-fit: cover;
    align-self: flex-end;
  }
  .msg-col {
    display: grid;
    gap: 6px;
    justify-items: start;
  }
  .msg-nome {
    font-family: var(--font-display);
    font-size: 0.82rem;
    color: var(--accent);
    font-weight: 600;
  }
  .bubble-ale {
    border-radius: 14px 14px 14px 4px;
    background: var(--accent);
    color: var(--ink);
    border: 0;
    display: none;
  }
  .typing {
    display: inline-flex;
    gap: 5px;
    padding: 16px 18px;
    border-radius: 14px 14px 14px 4px;
    background: rgba(255, 255, 255, 0.1);
  }
  .typing span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.7);
    animation: blink 1.2s infinite;
  }
  .typing span:nth-child(2) {
    animation-delay: 0.15s;
  }
  .typing span:nth-child(3) {
    animation-delay: 0.3s;
  }
  @keyframes blink {
    0%,
    80%,
    100% {
      opacity: 0.3;
      transform: translateY(0);
    }
    40% {
      opacity: 1;
      transform: translateY(-3px);
    }
  }
  .msg.is-typed .typing {
    display: none;
  }
  .msg.is-typed .bubble-ale {
    display: block;
    animation: pop 0.5s var(--ease);
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
  }
  .msg-cta {
    justify-content: center;
    margin-top: 24px;
  }

  /* ================= DEPOIMENTOS ================= */
  .testi {
    padding: 20px var(--gutter);
    background: var(--bg);
  }
  .testi-box {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-xl);
    background: var(--dark-2);
    padding: clamp(64px, 9vw, 120px) 0 clamp(48px, 6vw, 80px);
  }
  .testi-bg {
    position: absolute;
    inset: 0;
  }
  .testi-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.35;
  }
  .testi-bg span {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--dark-2) 0%, rgba(43, 37, 30, 0.6) 50%, var(--dark-2) 100%);
  }
  .testi-head,
  .video {
    position: relative;
    max-width: 860px;
    margin: 0 auto;
    padding: 0 var(--gutter);
    text-align: center;
  }
  .testi-head .sec-title .serif-italic {
    color: var(--accent);
  }
  .testi-head .sec-lede {
    margin: 0 auto;
  }
  .testi-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 16px;
    border-radius: var(--r-sm);
    background: rgba(245, 196, 0, 0.14);
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 22px;
  }
  .video {
    margin-top: 48px;
    margin-bottom: 48px;
  }
  .video-facade,
  .video :global(iframe) {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    padding: 0;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: #000;
    box-shadow: var(--shadow-lg);
  }
  button.video-facade {
    cursor: pointer;
  }
  .video-facade img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease);
  }
  .video-facade:hover img {
    transform: scale(1.04);
  }
  .play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 88px;
    height: 88px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 14px rgba(245, 196, 0, 0.22);
    animation: pulse 2.4s infinite;
  }
  .play::after {
    content: '';
    position: absolute;
    left: 35px;
    top: 27px;
    border-left: 24px solid var(--ink);
    border-top: 17px solid transparent;
    border-bottom: 17px solid transparent;
  }
  .testi-mq {
    position: relative;
  }
  .testi-track {
    padding: 6px 0;
  }
  .testi-track > * {
    margin-right: 18px;
  }
  .t-card {
    flex: none;
    width: 360px;
    display: flex;
    flex-direction: column;
    padding: 26px;
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .t-card p {
    flex: 1;
    font-size: 1.02rem;
    color: rgba(255, 255, 255, 0.88);
  }
  .t-div {
    height: 1px;
    background: rgba(255, 255, 255, 0.12);
    margin: 6px 0 16px;
  }
  .t-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .t-name {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
  }
  .t-role {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.55);
  }
  .t-foot :global(.t-quote) {
    color: var(--accent);
    opacity: 0.8;
  }

  /* ================= GUIA ================= */
  .guia-box {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    border-radius: var(--r-xl);
    overflow: hidden;
    background: var(--sand);
  }
  .guia-copy {
    padding: clamp(32px, 5vw, 64px);
  }
  .checks {
    list-style: none;
    padding: 0;
    margin: 28px 0 32px;
    display: grid;
    gap: 12px;
  }
  .checks li {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .checks :global(svg) {
    flex: none;
    width: 26px;
    height: 26px;
    padding: 5px;
    border-radius: 50%;
    background: var(--accent);
  }
  .guia-visual {
    display: grid;
    place-items: center;
    padding: 40px;
    background:
      radial-gradient(circle at 30% 20%, rgba(245, 196, 0, 0.35), transparent 60%),
      var(--dark);
  }
  .livro {
    width: min(100%, 260px);
    aspect-ratio: 3 / 4;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 26px;
    border-radius: 4px 10px 10px 4px;
    background: var(--accent);
    color: var(--ink);
    box-shadow:
      inset 8px 0 0 rgba(0, 0, 0, 0.12),
      30px 40px 60px -20px rgba(0, 0, 0, 0.6);
    transform: perspective(900px) rotateY(-14deg) rotateX(4deg);
    transition: transform 0.8s var(--ease);
  }
  .guia-box:hover .livro {
    transform: perspective(900px) rotateY(-4deg) rotateX(0);
  }
  .livro-tag {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .livro-titulo {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2rem;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .livro-titulo .serif-italic {
    display: block;
    font-weight: 400;
  }
  .livro-autor {
    font-size: 0.85rem;
  }

  /* ================= FAQ ================= */
  .faq {
    padding-top: 0;
  }
  .faq-grid {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: 20px;
    align-items: start;
  }
  .faq-aside {
    position: sticky;
    top: 110px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    padding: 32px;
    border-radius: var(--r-lg);
    background: var(--dark);
    color: #fff;
    min-height: 340px;
  }
  .faq-aside-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    margin-bottom: 8px;
  }
  .faq-aside-desc {
    color: rgba(255, 255, 255, 0.7);
  }
  .faq-person {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
  }
  .faq-person img {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 2px solid var(--accent);
  }
  .faq-person-name {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
  }
  .faq-person-role {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
  }
  .faq-list {
    display: grid;
    gap: 10px;
  }
  .faq-item {
    border-radius: var(--r-md);
    background: var(--surface);
    border: 1px solid var(--line);
    transition: box-shadow 0.4s;
  }
  .faq-item[open] {
    box-shadow: var(--shadow-sm);
  }
  .faq-item summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 22px 24px;
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.12rem;
    letter-spacing: -0.02em;
  }
  .faq-item summary::-webkit-details-marker {
