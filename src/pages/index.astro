---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import Polaroid from '../components/Polaroid.astro';
import PolaStrip from '../components/PolaStrip.astro';
import { SITE, waLink } from '../config';

const temas = [
  'Aluguel na Itália', 'Codice fiscale', 'Permesso di soggiorno', 'Residência', 'Reserva financeira',
  'Escolha da cidade', 'Escola dos filhos', 'Médico de família', 'Custo de vida', 'Concurso público',
  'Monza', 'Milão', 'Lombardia', 'Cidadania italiana', 'Visto',
];

const vitrine = [
  { img: 'card-aluguel', titulo: 'Aluguel antes do embarque', texto: 'Eu faço a ponte com imobiliárias e proprietários para você chegar com o contrato encaminhado.' },
  { img: 'card-monza', titulo: 'A cidade certa para você', texto: 'Escolhida pelo seu perfil, trabalho e rede de apoio, não pela moda do Instagram.' },
  { img: 'card-reserva', titulo: 'Reserva na medida', texto: 'Quanto juntar para atravessar os primeiros meses com paz, sem expor a sua família.' },
  { img: 'card-documentos', titulo: 'Documentos na ordem certa', texto: 'Codice fiscale, permesso, residência e médico de família, sem passos no escuro.' },
  { img: 'card-escola', titulo: 'Os filhos na escola', texto: 'Idioma, matrícula e adaptação: o que eu vivi com os meus três, para os seus.' },
  { img: 'card-chegada', titulo: 'Chegada acompanhada', texto: 'Na Questura, na prefeitura e na rua, com alguém que fala a língua deles ao seu lado.' },
];

const situacoes = [
  { titulo: 'Você tem a cidadania, ou está quase, e não sabe por onde começar.', texto: 'O passaporte está chegando, o sonho é antigo, mas ninguém te explicou a ordem certa: cidade, casa, documentos, trabalho.' },
  { titulo: 'Você já pesquisou demais e está perdido em informação solta.', texto: 'Cada vídeo diz uma coisa. Você quer números reais e alguém que viva o chão da Itália todos os dias.' },
  { titulo: 'Você já tem um plano e quer validá-lo antes de vender tudo.', texto: 'Antes de colocar o patrimônio da família em jogo, quer que alguém experiente aponte as falhas do seu projeto.' },
];

const historia = [
  { ano: '2003', titulo: 'Tinha tudo, menos segurança', texto: 'Um sequestro relâmpago e um assalto à mão armada em São Paulo.' },
  { ano: '2003', titulo: 'Cheguei com 2 euros', texto: 'Primeira noite no saguão do aeroporto de Nice, mais de 100 portas fechadas.' },
  { ano: '2004', titulo: 'A casa na montanha', texto: 'A família reunida numa vila de 90 habitantes. Uma moto velha e o eBay.' },
  { ano: 'Hoje', titulo: 'A raiz deu frutos', texto: 'Funcionário público em Monza. Três filhos trilíngues, construindo a própria vida.' },
];

const slides = [
  { img: 'story-1', legenda: 'Do Brasil para a Itália' },
  { img: 'story-2', legenda: 'Nós cinco, uma rocha' },
  { img: 'story-3', legenda: 'Hoje · A Itália que me acolheu' },
];

const etapas = [
  { icon: 'users', titulo: 'Diagnóstico do perfil', texto: 'Um questionário e uma conversa sem pressa sobre a sua família, renda, documentos e momento.' },
  { icon: 'compass', titulo: 'A cidade certa', texto: 'Não a da moda: a que combina com o seu perfil, o seu trabalho e a sua rede de apoio.' },
  { icon: 'wallet', titulo: 'Reserva e documentos', texto: 'Quanto juntar, o que tirar ainda no Brasil e a ordem certa da burocracia.' },
  { icon: 'key', titulo: 'Aluguel antes do embarque', texto: 'Eu faço a ponte com imobiliárias e proprietários que confiam no meu nome.' },
  { icon: 'plane', titulo: 'Chegada acompanhada', texto: 'Questura, residência, codice fiscale e médico de família, comigo ao seu lado.' },
  { icon: 'home', titulo: 'Integração e rede', texto: 'Apresento você a quem importa. Na Itália, as relações se criam assim.' },
];

const diferenciais = [
  { icon: 'key', titulo: 'Aluguel encaminhado antes do embarque', texto: 'O proprietário italiano é conservador e desconfiado. Eu pesquiso em média 50 apartamentos por contrato e coloco o meu nome e a minha credibilidade na mesa por famílias preparadas.' },
  { icon: 'clock', titulo: '23 anos de chão real', texto: 'Eu passei por tudo: frio, solidão, crise, burocracia. Não ensino teoria de internet, ensino o que vivi e o que vejo toda semana com as famílias que acompanho.' },
  { icon: 'compass', titulo: 'A cidade certa, mesmo que não seja Monza', texto: 'Já recusei uma família que insistia em vir para Monza porque toda a estrutura de apoio dela estava em outra região. A cidade certa é a que combina com você.' },
  { icon: 'shield', titulo: 'Ao seu lado na burocracia', texto: 'Na Questura, na prefeitura, no codice fiscale. Falando a língua deles e do mesmo nível. Com alguém ao lado, a porta que estava fechada se abre.' },
];

const conversas = [
  { p: 'Tenho medo de vender tudo, chegar aí e não dar certo.', a: 'Esse medo é sinal de responsabilidade, e eu senti o mesmo. Por isso a gente começa pelo planejamento: reserva, documentos e casa antes da mala. Ninguém que respeita a sua família vai te mandar vir no susto.' },
  { p: 'Dá mesmo para alugar um apartamento ainda estando no Brasil?', a: 'É o que eu mais faço. Converso com imobiliárias e proprietários, explico quem é a sua família e coloco o meu nome na mesa. O Rafael e a Luciana embarcaram com o contrato encaminhado.' },
  { p: 'E se a cidade que eu escolhi não for a certa para nós?', a: 'Então eu vou te dizer, com toda a sinceridade. A escolha parte do seu perfil, do seu trabalho e da sua rede de apoio, não do que está na moda no Instagram.' },
];

const depoimentos = [
  'Quando você falou que o apartamento era nosso, em quatro horas eu já tinha comprado a passagem. Sem isso, a gente não embarcaria.',
  'Se não tivesse encontrado você, a gente estaria ainda no Brasil, ainda estudando como viabilizar tudo.',
  'O teu trabalho é humanizado, é sério, tem um lado emocional. Você tem a impressão de que está com uma mão te ajudando a caminhar.',
  'A nossa família olha para você e sente confiança. Parece um tio, um pai ou um irmão que está lá para te receber.',
  'A segurança não é só para quem vem. É para quem fica também.',
  'As portas que você está abrindo para a gente, isso é impagável.',
  'Achei que o trem de Monza para Milão custaria uns 12 euros. Paguei 2,60.',
];

const faqs = [
  { q: 'A mentoria é em grupo ou individual?', a: 'Individual. Cada família tem as suas chamadas comigo, desde o planejamento no Brasil até os primeiros passos na Itália.' },
  { q: 'Preciso ter cidadania italiana?', a: 'Não necessariamente. Existem dois caminhos legais: a cidadania ou um visto bem amarrado. O que não dá é vir sem chão jurídico, porque aluguel, escola e saúde exigem residência legal.' },
  { q: 'Você garante o aluguel?', a: 'Eu não prometo milagre: eu coloco o meu nome e a minha credibilidade na mesa por famílias preparadas. Por isso a preparação, com reserva e documentos em ordem, faz parte da mentoria.' },
  { q: 'Só atende quem quer morar em Monza?', a: 'Não. Eu conheço bem o norte da Itália e indico a cidade pelo seu perfil. Se a sua estrutura de apoio estiver em outra região, eu vou te dizer para ir para lá.' },
  { q: 'Quanto dinheiro preciso para me mudar?', a: 'Como meta mínima: 10 mil euros sozinho, 15 mil em casal e 20 mil com filhos. Na mentoria, a gente calcula a reserva exata da sua família.' },
  { q: 'Já tenho um plano. A mentoria serve para mim?', a: 'Sim. Além de construir o plano do zero, eu faço o ajuste fino: valido cada etapa do projeto que você já tem para zerar as falhas antes do embarque.' },
];
---
<Base
  title="Vida Italiana na Prática | Mentoria para imigrar para a Itália com segurança"
  description="Mentoria individual com o Alexandre, há 23 anos na Itália, para famílias brasileiras que querem imigrar com segurança: cidade certa, reserva, documentos e aluguel."
>
  <Header />
  <main id="main">
    <!-- HERO -->
    <section class="hero on-dark">
      <img class="hero-photo" src="/fotos/hero-bg.jpg" alt="" fetchpriority="high" width="1920" height="1200" />
      <span class="hero-veil" aria-hidden="true"></span>
      <div class="container hero-inner">
        <div class="hero-content">
          <p class="hero-eyebrow fx-up" style="--i:0"><Icon name="pin" size={16} /> Direto de Monza, Itália</p>
          <h1 class="hero-title">
            <span class="hero-line"><span style="--i:1"><span class="serif-italic">Imigrar</span> para a Itália,</span></span>
            <span class="hero-line"><span style="--i:2">com os <span class="grifo">pés no chão</span></span></span>
          </h1>
          <div class="hero-lede fx-up" style="--i:3">
            <p>Cada família tem o seu <span class="hero-word" data-rotate="tempo,caminho,cidade,plano">tempo</span>.</p>
            <p>Mentoria individual para quem quer recomeçar na Itália <strong>com segurança</strong>, guiado por quem vive lá há 23 anos.</p>
          </div>
          <div class="hero-cta fx-up" style="--i:4">
            <a href={waLink()} class="btn btn-accent"><Icon name="whatsapp" /> Quero desenhar minha travessia</a>
            <a href="#historia" class="btn btn-ghost">Conheça o Alexandre <Icon name="arrow" size={16} /></a>
          </div>
          <p class="hero-filtro fx-up" style="--i:5">
            <Icon name="badge" size={16} />
            <span><strong>Acompanhamento individual.</strong> Do Brasil até a chave na mão.</span>
          </p>
          <ul class="hero-creds fx-up" style="--i:6" aria-label="Credenciais">
            <li><strong>23</strong><span>anos vivendo<br />na Itália</span></li>
            <li><strong>~50</strong><span>apartamentos pesquisados<br />por contrato</span></li>
            <li><strong>3</strong><span>filhos criados<br />na Itália</span></li>
          </ul>
        </div>

      </div>
    </section>

    <!-- FAIXA DE TEMAS -->
    <div class="topics mq" role="group" aria-label="Temas da mentoria">
      <div class="mq-track topics-track" style="--dur:55s" aria-hidden="true">
        {[...temas, ...temas].map((t) => <span class="topic">{t}<span class="topic-sep">◆</span></span>)}
      </div>
    </div>

    <!-- VITRINE -->
    <section class="vitrine">
      <Polaroid side="left" x="calc(50% - 380px - 250px)" top="70px" rot={-7} speed={0.12} src="pola-brasil" cap="O Brasil no coração" />
      <Polaroid x="calc(50% - 380px - 250px)" top="110px" rot={6} src="pola-italia" cap="A Itália real" />
      <div class="container sec-head center reveal">
        <p class="std-tag"><span class="std-dot"></span> O que a mentoria cobre</p>
        <h2 class="sec-title">Tudo o que derruba uma família na chegada, <span class="grifo">resolvido antes</span>.</h2>
        <p class="sec-lede">Os pontos que mais fazem brasileiros voltarem para casa, e como eu cuido de cada um com você.</p>
      </div>
      <div class="mq vitrine-mq">
        <div class="mq-track vitrine-track" style="--dur:70s">
          {[...vitrine, ...vitrine].map((c, i) => (
            <a class="v-card" href={waLink()} aria-hidden={i >= vitrine.length ? 'true' : undefined} tabindex={i >= vitrine.length ? -1 : undefined}>
              <img src={`/fotos/${c.img}.jpg`} alt="" loading="lazy" width="900" height="1200" />
              <span class="v-veil"></span>
              <div class="v-text">
                <span class="v-num">0{(i % vitrine.length) + 1}</span>
                <h3>{c.titulo}</h3>
                <p>{c.texto}</p>
                <span class="v-link">Falar sobre isso <Icon name="arrow" size={15} /></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <PolaStrip fotos={[
      { src: 'pola-italia', cap: 'A Itália real' },
      { src: 'pola-familia', cap: 'Família reunida' },
      { src: 'pola-brasil', cap: 'O Brasil no coração' },
      { src: 'pola-se', cap: 'São Paulo, com os meus' },
    ]} />

    <!-- QUEM CHEGA AQUI -->
    <section class="sec quem">
      <div class="container">
        <Polaroid x="calc(var(--edge) + 40px)" top="50px" rot={5} width={190} src="pola-familia" cap="Família reunida" />
        <div class="sec-head reveal">
          <p class="std-tag"><span class="std-dot"></span> Quem chega até mim</p>
          <h2 class="sec-title">Talvez você se reconheça em <span class="grifo">alguma dessas situações</span>.</h2>
        </div>
        <div class="quem-grid">
          {situacoes.map((s, i) => (
            <article class="quem-card reveal" style={`--d:${i * 0.1}s`}>
              <div class="quem-top">
                <span class="quem-num">0{i + 1}</span>
                <span class="quem-sit">Situação {['I', 'II', 'III'][i]}</span>
              </div>
              <h3>{s.titulo}</h3>
              <p>{s.texto}</p>
              <a href={waLink()} class="quem-cta"><Icon name="whatsapp" size={16} /> Quero conversar</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- SOBRE -->
    <section class="sec sobre" id="historia">
      <Polaroid side="left" x="calc(var(--edge) - var(--w) + 56px)" top="8%" rot={-6} speed={0.12} src="pola-rio" cap="Rio de Janeiro" />
      <Polaroid x="calc(var(--edge) - var(--w) + 56px)" top="52%" rot={6} src="pola-se" cap="São Paulo, com os meus" />
      <div class="container sobre-grid">
        <div class="sobre-card reveal">
          <span class="sobre-dots" aria-hidden="true"></span>
          <p class="std-tag"><span class="std-dot"></span> Quem conduz a mentoria</p>
          <h2 class="sobre-title"><span class="serif-italic">Prazer,</span> <span class="grifo">Alexandre</span></h2>
          <p class="sobre-cred"><Icon name="badge" size={16} /> <strong>23 anos na Itália</strong><span>Funcionário público em Monza</span><span>Pai de 3</span></p>
          <p>Em 2003, eu tinha a vida que a classe média brasileira considera ideal: ótimo emprego, apartamento, dois carros e escola particular. Até que um sequestro relâmpago e um assalto à mão armada me mostraram que eu tinha tudo, menos segurança.</p>
          <p>Vim sozinho, sem falar italiano, com 2 euros no bolso. Bati em mais de cem portas, passei frio e solidão, e reuni a minha família numa casa de 300 euros na montanha. Hoje, meus três filhos são adultos realizados na Itália. <strong>Eu estendo a mão para você, como alguém um dia fez comigo.</strong></p>
          <div class="sobre-cta">
            <a href={waLink()} class="btn btn-accent"><Icon name="whatsapp" size={16} /> Falar com o Alexandre</a>
            <a href="#mentoria" class="btn btn-ghost">Como funciona a mentoria <Icon name="arrow" size={16} /></a>
          </div>
        </div>
        <div class="story reveal" style="--d:.15s" data-story>
          <div class="story-bars" aria-hidden="true">
            {slides.map(() => <span><i></i></span>)}
          </div>
          {slides.map((s, i) => (
            <figure class:list={['story-slide', i === 0 && 'is-on']}>
              <img src={`/fotos/${s.img}.jpg`} alt={s.legenda} loading="lazy" width="800" height="800" />
              <figcaption>{s.legenda}</figcaption>
            </figure>
          ))}
          <div class="story-head">
            <img src="/fotos/alexandre-avatar.jpg" alt="" width="40" height="40" />
            <span class="story-name">Alexandre <Icon name="badge" size={14} /></span>
            <span class="story-meta">Monza, Itália</span>
          </div>
        </div>
      </div>
      <div class="container">
        <ol class="linha">
          {historia.map((h, i) => (
            <li class="reveal" style={`--d:${i * 0.1}s`}>
              <span class="linha-ano">{h.ano}</span>
              <h3>{h.titulo}</h3>
              <p>{h.texto}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <PolaStrip reverse fotos={[
      { src: 'pola-rio', cap: 'Rio de Janeiro' },
      { src: 'pola-estrada', cap: 'Sempre pronto pra estrada' },
      { src: 'pola-masp', cap: 'Visita ao MASP' },
      { src: 'pola-mar', cap: 'Olhando o mar' },
    ]} />

    <!-- JORNADA -->
    <section class="sec jornada" id="mentoria">
      <div class="container">
        <Polaroid x="calc(var(--edge) + 40px)" top="90px" rot={-5} width={190} speed={0.1} src="pola-estrada" cap="Sempre pronto pra estrada" />
        <div class="sec-head reveal">
          <p class="std-tag"><span class="std-dot"></span> Como a mentoria funciona</p>
          <h2 class="sec-title">Seis passos. <span class="grifo">Nenhum no escuro.</span></h2>
          <p class="sec-lede">Acompanhamento individual, em chamadas, do planejamento no Brasil à chave na mão. Eu sou as suas pernas e os seus olhos no solo italiano.</p>
        </div>
        <ol class="jor-grid">
          {etapas.map((e, i) => (
            <li class="jor-card reveal" style={`--d:${(i % 3) * 0.1}s`}>
              <div class="jor-top">
                <span class="jor-ico"><Icon name={e.icon} /></span>
                <span class="jor-num">0{i + 1}</span>
              </div>
              <h3>{e.titulo}</h3>
              <p>{e.texto}</p>
            </li>
          ))}
        </ol>
        <div class="modos">
          <article class="modo modo-dark on-dark reveal">
            <span class="modo-tag">Plano do zero</span>
            <h3>Ainda estou no começo</h3>
            <p>Para quem tem o sonho, mas não sabe por onde começar. Construímos juntos o caminho legal, a cidade, a reserva, os documentos e a chegada.</p>
            <a href={waLink()} class="btn btn-accent btn-sm">Começar do zero <Icon name="arrow" size={15} /></a>
          </article>
          <article class="modo reveal" style="--d:.1s">
            <span class="modo-tag">Ajuste fino</span>
            <h3>Já tenho um plano</h3>
            <p>Para quem já estudou e se organizou. Eu valido cada etapa do seu projeto, aponto os riscos e ajusto o que for preciso para zerar as falhas.</p>
            <a href={waLink()} class="btn btn-sm">Validar meu plano <Icon name="arrow" size={15} /></a>
          </article>
        </div>
      </div>
    </section>

    <!-- DIFERENCIAIS -->
    <section class="sec dif">
      <div class="container">
        <div class="sec-head reveal">
          <p class="std-tag"><span class="std-dot"></span> O que distingue</p>
          <h2 class="sec-title">O que só quem vive aqui <span class="grifo">consegue fazer</span>.</h2>
        </div>
        <div class="dif-grid">
          <div class="dif-acc" data-acc>
            {diferenciais.map((d, i) => (
              <article class:list={['dif-item', i === 0 && 'is-open']}>
                <button class="dif-q" type="button" aria-expanded={i === 0 ? 'true' : 'false'}>
                  <span class="dif-ico"><Icon name={d.icon} /></span>
                  <span class="dif-titulo">{d.titulo}</span>
                  <span class="dif-mark" aria-hidden="true"></span>
                </button>
                <div class="dif-a"><div><p>{d.texto}</p></div></div>
              </article>
            ))}
            <a href={waLink()} class="btn btn-accent dif-btn">Quero chegar com a chave na mão <Icon name="arrow" size={16} /></a>
          </div>
          <div class="dif-figure reveal">
            <div class="dif-slides" data-dif-slides>
              {[
                ['apto-1', 'Rua residencial com casas coloridas na Itália'],
                ['apto-2', 'Prédios residenciais às margens de um canal em Veneza'],
                ['apto-3', 'Sala de um apartamento italiano iluminado'],
                ['apto-4', 'Telhados residenciais de Florença'],
                ['apto-5', 'Ruela com prédios residenciais na Itália'],
              ].map(([src, alt], i) => (
                <img class:list={['dif-slide', i === 0 && 'is-on']} src={`/fotos/${src}.jpg`} alt={alt} loading="lazy" width="1200" height="1500" />
              ))}
            </div>
            <div class="dif-stat">
              <strong>~50</strong>
              <span>apartamentos pesquisados, em média, para cada contrato fechado</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CONVERSAS (OBJEÇÕES) -->
    <section class="obj on-dark">
      <Polaroid side="left" x="calc(50% - 380px - 250px)" top="34%" rot={-8} speed={0.14} src="pola-masp" cap="Visita ao MASP" />
      <Polaroid x="calc(50% - 380px - 250px)" top="58%" rot={7} src="pola-mar" cap="Olhando o mar" />
      <div class="obj-fx" aria-hidden="true">
        <span class="obj-grid"></span>
        <span class="obj-glow obj-glow-1"></span>
        <span class="obj-glow obj-glow-2"></span>
        <svg class="obj-lines" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
          <path d="M-100 220 C 360 60, 720 380, 1080 200 S 1640 120, 1640 320" />
          <path d="M-100 520 C 320 360, 760 700, 1140 480 S 1700 420, 1700 640" />
          <path d="M-100 740 C 420 600, 800 920, 1200 720 S 1680 660, 1700 860" />
        </svg>
      </div>
      <div class="container obj-inner">
        <div class="sec-head center reveal">
          <p class="std-tag"><span class="std-dot"></span> Antes da sua decisão</p>
          <h2 class="sec-title">Três conversas que talvez você esteja <span class="grifo">tendo agora</span>.</h2>
        </div>
        <div class="chat">
          {conversas.map((c) => (
            <>
              <div class="msg msg-eu" data-msg><div class="bubble">{c.p}</div></div>
              <div class="msg msg-ale" data-msg data-typing>
                <img class="msg-avatar" src="/fotos/alexandre-avatar.jpg" alt="Alexandre" loading="lazy" width="40" height="40" />
                <div class="msg-col">
                  <span class="msg-nome">Alexandre</span>
                  <div class="typing" aria-hidden="true"><span></span><span></span><span></span></div>
                  <div class="bubble bubble-ale">{c.a}</div>
                </div>
              </div>
            </>
          ))}
          <div class="msg msg-cta" data-msg>
            <a href={waLink()} class="btn btn-accent"><Icon name="whatsapp" /> Conversar no WhatsApp</a>
          </div>
        </div>
      </div>
    </section>

    <!-- DEPOIMENTOS -->
    <section class="testi" id="depoimentos">
      <div class="testi-box on-dark">
        <div class="testi-bg" aria-hidden="true">
          <img src="/fotos/testi-bg.jpg" alt="" loading="lazy" width="1920" height="1100" />
          <span></span>
        </div>
        <div class="testi-head reveal">
          <span class="testi-badge"><Icon name="star" size={14} /> Quem já fez o caminho</span>
