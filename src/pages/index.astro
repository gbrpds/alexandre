<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Fotos de apartamentos que se alternam no bloco "~50"
  const difSlides = document.querySelectorAll<HTMLElement>('[data-dif-slides] .dif-slide');
  if (difSlides.length > 1 && !reduced) {
    let difCur = 0;
    setInterval(() => {
      difSlides[difCur].classList.remove('is-on');
      difCur = (difCur + 1) % difSlides.length;
      difSlides[difCur].classList.add('is-on');
    }, 3800);
  }

  // Palavra que troca no hero
  const word = document.querySelector<HTMLElement>('[data-rotate]');
  if (word && !reduced) {
    const words = (word.dataset.rotate || '').split(',');
    let i = 0;
    setInterval(() => {
      word.classList.add('is-out');
      setTimeout(() => {
        i = (i + 1) % words.length;
        word.textContent = words[i];
        word.classList.remove('is-out');
      }, 380);
    }, 2600);
  }

  // Story com fotos que avançam sozinhas
  const story = document.querySelector<HTMLElement>('[data-story]');
  if (story) {
    const slides = [...story.querySelectorAll('.story-slide')];
    const bars = [...story.querySelectorAll('.story-bars span')];
    let cur = 0;
    const show = (n: number) => {
      slides.forEach((s, k) => s.classList.toggle('is-on', k === n));
      bars.forEach((b, k) => {
        b.classList.toggle('is-done', k < n);
        b.classList.toggle('is-active', k === n);
      });
    };
    show(0);
    if (!reduced) setInterval(() => show((cur = (cur + 1) % slides.length)), 4200);
  }

  // Acordeão dos diferenciais (um aberto por vez)
  document.querySelectorAll<HTMLElement>('[data-acc] .dif-item').forEach((item, _, all) => {
    item.querySelector('button')?.addEventListener('click', () => {
      all.forEach((o) => {
        const open = o === item;
        o.classList.toggle('is-open', open);
        o.querySelector('button')?.setAttribute('aria-expanded', String(open));
      });
    });
  });

  // Conversa: mensagens surgem ao entrar na tela, com "digitando..."
  const msgs = document.querySelectorAll<HTMLElement>('[data-msg]');
  const chatIo = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement;
        el.classList.add('is-in');
        if (el.hasAttribute('data-typing')) setTimeout(() => el.classList.add('is-typed'), reduced ? 0 : 1100);
        chatIo.unobserve(el);
      });
    },
    { threshold: 0.6 },
  );
  msgs.forEach((m) => chatIo.observe(m));

  // Vídeo só carrega ao clicar
  document.querySelectorAll<HTMLButtonElement>('[data-video]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.video}?autoplay=1`;
      iframe.title = 'Entrevista com Rafael e Luciana';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
      iframe.allowFullscreen = true;
      btn.replaceWith(iframe);
    });
  });

  // Formulário abre o WhatsApp com a mensagem pronta
  const form = document.getElementById('lead-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const note = form.querySelector('.form-note') as HTMLElement;
    const numero = form.dataset.whatsapp;
    const texto =
      `Olá, Alexandre! Sou ${data.get('nome')}.\n` +
      `Quem vem: ${data.get('quem')}\n` +
      `Documentação: ${data.get('doc')}\n` +
      `Meu momento: ${data.get('momento')}\n` +
      `Quero saber mais sobre a mentoria.`;
    if (!numero) {
      note.textContent = 'O WhatsApp ainda não foi configurado no site.';
      return;
    }
    window.open(`https://wa.me/${numero}?text=${encodeURIComponent(texto)}`, '_blank', 'noopener');
  });
</script>

