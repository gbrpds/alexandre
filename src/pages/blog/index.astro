---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Icon from '../../components/Icon.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const imgs: Record<string, string> = {
  'como-alugar-casa-na-italia': 'card-aluguel',
  'custo-de-vida-na-italia': 'card-custo',
  'reserva-financeira-para-morar-na-italia': 'card-reserva',
  'residencia-na-italia-primeiros-documentos': 'card-documentos',
  'morar-em-monza': 'card-monza',
  'concurso-publico-na-italia': 'card-concurso',
};
const [destaque, ...resto] = posts;
---
<Base
  title="Blog | Vida Italiana na Prática"
  description="Custo de vida, aluguel, documentos e a vida real na Itália, contados por quem mora lá há 23 anos."
>
  <Header variant="solid" />
  <main id="main" class="blog">
    <div class="container">
      <header class="blog-head reveal">
        <p class="std-tag"><span class="std-dot"></span> Blog</p>
        <h1>A Itália real, <span class="serif-italic">sem romantismo.</span></h1>
        <p class="sec-lede">Números, documentos e histórias de quem vive há 23 anos no chão italiano. Para você se planejar com os pés no chão.</p>
      </header>

      {destaque && (
        <a href={`/blog/${destaque.id}`} class="destaque reveal">
          <img src={`/fotos/${imgs[destaque.id] ?? 'card-monza'}.jpg`} alt="" width="900" height="1200" />
          <div class="destaque-text">
            <span class="cat">{destaque.data.category}</span>
            <h2>{destaque.data.title}</h2>
            <p>{destaque.data.description}</p>
            <span class="more">Ler artigo <Icon name="arrow" size={16} /></span>
          </div>
        </a>
      )}

      <div class="grid">
        {resto.map((p, i) => (
          <a href={`/blog/${p.id}`} class="card reveal" style={`--d:${(i % 3) * 0.08}s`}>
            <div class="card-img">
              <img src={`/fotos/${imgs[p.id] ?? 'card-monza'}.jpg`} alt="" loading="lazy" width="900" height="1200" />
            </div>
            <span class="cat">{p.data.category}</span>
            <h2>{p.data.title}</h2>
            <span class="more">Ler artigo <Icon name="arrow" size={15} /></span>
          </a>
        ))}
      </div>
    </div>
  </main>
</Base>

<style>
  .blog {
    padding: 150px 0 120px;
  }
  .blog-head {
    max-width: 760px;
    margin-bottom: 56px;
  }
  .blog-head h1 {
    font-size: clamp(2.6rem, 6vw, 4.8rem);
  }
  .blog-head h1 .serif-italic {
    font-size: 1.06em;
  }
  .cat {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--terra);
    margin-bottom: 10px;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display);
    font-weight: 600;
  }
  .destaque {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-radius: var(--r-xl);
    overflow: hidden;
    background: var(--dark);
    color: #fff;
    text-decoration: none;
    margin-bottom: 24px;
  }
  .destaque img {
    width: 100%;
    height: 100%;
    max-height: 520px;
    object-fit: cover;
    transition: transform 1.2s var(--ease);
  }
  .destaque:hover img {
    transform: scale(1.04);
  }
  .destaque-text {
    padding: clamp(28px, 5vw, 56px);
    align-self: center;
  }
  .destaque h2 {
    font-size: clamp(1.8rem, 3.4vw, 2.8rem);
  }
  .destaque p {
    color: rgba(255, 255, 255, 0.72);
  }
  .destaque .cat,
  .destaque .more {
    color: var(--accent);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    padding: 14px 14px 24px;
    border-radius: var(--r-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease);
  }
  .card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-md);
  }
  .card-img {
    border-radius: var(--r-md);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    margin-bottom: 20px;
  }
  .card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease);
  }
  .card:hover .card-img img {
    transform: scale(1.06);
  }
  .card .cat,
  .card h2,
  .card .more {
    padding: 0 10px;
  }
  .card h2 {
    font-size: 1.35rem;
    flex: 1;
  }
  @media (max-width: 960px) {
    .destaque {
      grid-template-columns: 1fr;
    }
    .destaque img {
      max-height: 320px;
    }
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 620px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
