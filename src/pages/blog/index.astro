---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const categorias = [...new Set(posts.map((p) => p.data.category))];
---
<Base
  title="Blog | Vida Italiana na Prática"
  description="Custo de vida, aluguel, documentos e a vida real na Itália, contados por quem mora lá há 23 anos."
>
  <Header solid />
  <section class="blog-hero on-dark">
    <div class="container">
      <p class="eyebrow">Blog</p>
      <h1>A Itália real, <em class="hl">sem romantismo.</em></h1>
      <p class="lead">Números, documentos e histórias de quem vive há 23 anos no chão italiano. Para você se planejar com os pés no chão.</p>
    </div>
  </section>
  <section class="section list">
    <div class="container">
      <ul class="cats" aria-label="Categorias">
        {categorias.map((c) => <li>{c}</li>)}
      </ul>
      <div class="grid">
        {posts.map((p) => (
          <a href={`/blog/${p.id}`} class="card">
            <span class="cat">{p.data.category}</span>
            <h2>{p.data.title}</h2>
            <p>{p.data.description}</p>
            <span class="more">Ler artigo →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .blog-hero {
    background: var(--olive);
    color: #fff;
    padding: 56px 0 72px;
  }
  .cats {
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .cats li {
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    padding: 6px 14px;
    font-size: 0.85rem;
    font-weight: 700;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
  }
  .card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px -26px rgba(0, 0, 0, 0.5);
  }
  .cat {
    font-family: var(--font-impact);
    font-weight: 800;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--terracotta);
    margin-bottom: 12px;
  }
  .card h2 {
    font-size: 1.35rem;
  }
  .card p {
    color: var(--ink-soft);
    font-size: 0.95rem;
    flex: 1;
  }
  .more {
    font-weight: 700;
  }
</style>
