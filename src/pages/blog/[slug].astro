---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, category, cta } = post.data;

const outros = (await getCollection('blog')).filter((p) => p.id !== post.id).slice(0, 3);
const dataFmt = date.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  inLanguage: 'pt-BR',
  author: { '@type': 'Person', name: 'Alexandre' },
  publisher: { '@type': 'Organization', name: 'Vida Italiana na Prática' },
  mainEntityOfPage: new URL(`/blog/${post.id}`, Astro.site).toString(),
};
---
<Base title={`${title} | Vida Italiana na Prática`} description={description} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <Header solid />
  <article>
    <header class="post-hero on-dark">
      <div class="container narrow">
        <a href="/blog" class="back">← Blog</a>
        <p class="eyebrow">{category}</p>
        <h1>{title}</h1>
        <p class="meta">Por <strong>Alexandre</strong> · {dataFmt}</p>
      </div>
    </header>
    <div class="container narrow prose">
      <Content />
    </div>
  </article>

  <aside class="cta-box container narrow">
    {cta === 'guia' ? (
      <>
        <p class="eyebrow">Para começar hoje</p>
        <h2>Planeje a sua mudança com o meu guia digital</h2>
        <p>Tudo o que eu aprendi em 23 anos, organizado para você se planejar com os pés no chão.</p>
        <div class="cta-actions">
          <a href="/#guia" class="btn btn-primary">Conhecer o guia</a>
          <a href="/#mentoria" class="btn btn-ghost">Ver a mentoria</a>
        </div>
      </>
    ) : (
      <>
        <p class="eyebrow">Mentoria individual</p>
        <h2>Quer desenhar a sua travessia com segurança?</h2>
        <p>Eu acompanho a sua família do planejamento no Brasil até a chave na mão na Itália.</p>
        <div class="cta-actions">
          <a href="/#contato" class="btn btn-primary">Falar com o Alexandre</a>
          <a href="/#mentoria" class="btn btn-ghost">Como funciona</a>
        </div>
      </>
    )}
  </aside>

  {outros.length > 0 && (
    <section class="section outros">
      <div class="container narrow">
        <h2>Continue lendo</h2>
        <ul>
          {outros.map((p) => (
            <li><a href={`/blog/${p.id}`}><span>{p.data.category}</span>{p.data.title}</a></li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Base>

<style>
  .narrow {
    max-width: 760px;
  }
  .post-hero {
    background: var(--olive);
    color: #fff;
    padding: 48px 0 64px;
  }
  .post-hero h1 {
    font-size: clamp(2rem, 4.6vw, 3.2rem);
  }
  .back {
    display: table;
    margin-bottom: 24px;
    text-decoration: none;
    opacity: 0.8;
  }
  .meta {
    color: rgba(255, 255, 255, 0.75);
    margin: 0;
  }
  .prose {
    padding-top: 56px;
    padding-bottom: 24px;
    font-size: 1.1rem;
    line-height: 1.75;
  }
  .prose :global(h2) {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    margin-top: 2em;
  }
  .prose :global(h3) {
    margin-top: 1.6em;
  }
  .prose :global(a) {
    color: var(--ink);
    text-decoration-color: var(--yellow);
    text-decoration-thickness: 3px;
    text-underline-offset: 3px;
    font-weight: 600;
  }
  .prose :global(blockquote) {
    margin: 2em 0;
    padding: 20px 24px;
    background: var(--cream);
    border-left: 4px solid var(--yellow);
    border-radius: 0 12px 12px 0;
    font-family: var(--font-serif);
    font-size: 1.15rem;
  }
  .prose :global(blockquote p:last-child) {
    margin: 0;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5em 0 2em;
    font-size: 0.98rem;
  }
  @media (max-width: 640px) {
    .prose :global(table) {
      display: block;
      overflow-x: auto;
    }
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
  }
  .prose :global(th) {
    background: var(--ink);
    color: #fff;
    font-weight: 700;
  }
  .prose :global(tr:nth-child(even) td) {
    background: rgba(244, 236, 221, 0.6);
  }
  .prose :global(ul.contains-task-list) {
    list-style: none;
    padding: 20px 24px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
  }
  .prose :global(.task-list-item) {
    margin: 8px 0;
  }
  .prose :global(.task-list-item input) {
    accent-color: var(--yellow);
    margin-right: 10px;
    transform: scale(1.2);
  }
  .prose :global(hr) {
    border: 0;
    height: 2px;
    background: var(--line);
    margin: 3em 0;
  }
  .cta-box {
    margin: 32px auto 0;
    background: var(--ink);
    color: #fff;
    border-radius: 20px;
    padding: clamp(28px, 5vw, 44px);
  }
  .cta-box .eyebrow {
    color: var(--yellow);
  }
  .cta-box p {
    color: rgba(255, 255, 255, 0.82);
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 20px;
  }
  .cta-box .btn-ghost {
    color: #fff;
  }
  .outros ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .outros li a {
    display: block;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    font-family: var(--font-serif);
    font-size: 1.2rem;
  }
  .outros li a span {
    display: block;
    font-family: var(--font-impact);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--terracotta);
  }
  .outros li a:hover {
    color: var(--terracotta);
  }
</style>
