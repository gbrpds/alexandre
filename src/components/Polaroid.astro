---
// Polaroid decorativa (desktop). A posição horizontal é um valor CSS livre,
// medido a partir da borda escolhida, para encaixar nos espaços vazios da seção.
interface Props {
  src: string;
  cap: string;
  side?: 'left' | 'right';
  top?: string;
  x?: string;
  width?: number;
  rot?: number;
  speed?: number;
}
const { src, cap, side = 'right', top = '80px', x = '24px', width = 200, rot = -4, speed = 0.08 } = Astro.props;
---
<div class:list={['deco', `deco-${side}`]} style={`--top:${top};--side:${x};--w:${width}px`} data-speed={speed} aria-hidden="true">
  <figure class="pola" style={`--rot:${rot}deg`}>
    <img src={`/fotos/${src}.jpg`} alt="" loading="lazy" width="700" height="700" />
    <figcaption>{cap}</figcaption>
  </figure>
</div>
