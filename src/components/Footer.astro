---
import Icon from './Icon.astro';
import { SITE, waLink } from '../config';
interface Props {
  semWhatsapp?: boolean;
}
const { semWhatsapp = false } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="ft on-dark">
  <div class="container">
    <div class="ft-grid">
      <div class="ft-brand">
        <a href="/" class="ft-logo"><img class="logo-mark" src="/fotos/logo-alexandre.png" alt="" width="40" height="40" /> Vida Italiana <span class="serif-italic">na Prática</span></a>
        <p>Mentoria individual para famílias brasileiras que querem imigrar para a Itália com segurança. Direto de Monza, há 23 anos vivendo o chão real.</p>
        <div class="ft-social">
          {SITE.instagram && <a href={SITE.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" size={18} /></a>}
          {SITE.tiktok && <a href={SITE.tiktok} target="_blank" rel="noopener" aria-label="TikTok"><Icon name="tiktok" size={18} /></a>}
          {SITE.youtube && <a href={SITE.youtube} target="_blank" rel="noopener" aria-label="YouTube"><Icon name="youtube" size={18} /></a>}
        </div>
      </div>
      <div>
        <h3 class="ft-head">A mentoria</h3>
        <ul>
          <li><a href="/#historia">Minha história</a></li>
          <li><a href="/#mentoria">Como funciona</a></li>
          <li><a href="/#depoimentos">Depoimentos</a></li>
          <li><a href="/#faq">Perguntas frequentes</a></li>
        </ul>
      </div>
      <div>
        <h3 class="ft-head">Conteúdo</h3>
        <ul>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/blog/custo-de-vida-na-italia">Custo de vida na Itália</a></li>
          <li><a href="/blog/como-alugar-casa-na-italia">Como alugar casa</a></li>
          <li><a href="/#guia">Guia digital</a></li>
        </ul>
      </div>
      <div>
        <h3 class="ft-head">Contato</h3>
        <ul>
          {!semWhatsapp && <li><a href={waLink()}><Icon name="whatsapp" size={14} /> WhatsApp</a></li>}
          <li><span><Icon name="pin" size={14} /> Monza, Lombardia, Itália</span></li>
        </ul>
      </div>
    </div>
    <div class="ft-bottom">
      <p>© {year} Vida Italiana na Prática · Alexandre</p>
      <p>Feito com cuidado entre o Brasil e a Itália.</p>
    </div>
  </div>
  <div class="ft-end" aria-hidden="true">
    <span class="ft-glow ft-glow-1"></span>
    <span class="ft-glow ft-glow-2"></span>
    <span class="ft-glow ft-glow-3"></span>
    <p class="ft-giant">Vida Italiana <span class="serif-italic">na Prática</span></p>
  </div>
</footer>

<style>
  .ft {
    position: relative;
    overflow: hidden;
    background: var(--dark);
    padding: 90px 0 0;
    color: rgba(255, 255, 255, 0.72);
    background: linear-gradient(180deg, var(--dark) 0%, var(--dark) 55%, #2a1d12 100%);
    font-size: 0.95rem;
  }
  .ft-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 40px;
  }
  .ft-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    color: #fff;
    text-decoration: none;
    margin-bottom: 18px;
  }
  .ft-logo .serif-italic {
    color: var(--accent);
  }
  .logo-mark {
    width: 40px;
    height: 40px;
    border-radius: 50%;
  }
  .ft-brand p {
    max-width: 40ch;
  }
  .ft-social {
    display: flex;
    gap: 10px;
  }
  .ft-social a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.18);
  }
  .ft-head {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 18px;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }
  ul a,
  ul span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    transition: color 0.3s;
  }
  ul a:hover {
    color: var(--accent);
  }
  .ft-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.45);
  }
  .ft-end {
    position: relative;
    margin-top: 40px;
    padding: clamp(60px, 9vw, 140px) 0 0;
    overflow: hidden;
  }
  .ft-end::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(180deg, var(--dark) 0%, rgba(30, 26, 21, 0) 45%);
  }
  .ft-giant {
    z-index: 2;
  }
  .ft-glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  .ft-glow-1 {
    width: 70vw;
    height: 70vw;
    left: -20vw;
    bottom: -45vw;
    background: radial-gradient(circle, rgba(245, 196, 0, 0.45), transparent 62%);
  }
  .ft-glow-2 {
    width: 60vw;
    height: 60vw;
    right: -15vw;
    bottom: -38vw;
    background: radial-gradient(circle, rgba(182, 90, 54, 0.55), transparent 62%);
  }
  .ft-glow-3 {
    width: 50vw;
    height: 40vw;
    left: 25vw;
    bottom: -30vw;
    background: radial-gradient(ellipse, rgba(255, 226, 122, 0.25), transparent 65%);
  }
  .ft-giant {
    position: relative;
    margin: 0 0 -0.16em;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.6rem, 8.2vw, 9.5rem);
    letter-spacing: -0.055em;
    line-height: 1;
    white-space: nowrap;
    background: linear-gradient(180deg, #fff 0%, #fff1b8 35%, var(--accent) 70%, rgba(245, 196, 0, 0.35) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .ft-giant .serif-italic {
    font-weight: 400;
    letter-spacing: -0.02em;
  }
  @media (max-width: 860px) {
    .ft-grid {
      grid-template-columns: 1fr 1fr;
    }
    .ft-brand {
      grid-column: 1 / -1;
    }
  }
</style>
