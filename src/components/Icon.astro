const isFill = name in fills;
const body = isFill ? fills[name] : strokes[name] ?? '';
const cls = [name === 'arrow' ? 'ico-arrow' : '', className].filter(Boolean).join(' ');
---
{isFill ? (
  <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="currentColor" class={cls} aria-hidden="true" set:html={body} />
) : (
  <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={cls} aria-hidden="true" set:html={body} />
)}
