---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Icon from './Icon.astro';
import { waLink } from '../config';

interface Props {
  servico: string;
  mensagem: string;
}
const { servico, mensagem } = Astro.props;
---
<Base title={`Obrigado | ${servico} | Vida Italiana na Prática`} description="Recebemos suas respostas." noindex semWhatsapp>
  <Header variant="solid" minimal />
  <main id="main" class="obg">
    <div class="container obg-inner">
      <img class="obg-avatar" src="/fotos/alexandre-avatar.jpg" alt="Alexandre" width="96" height="96" />
      <p class="std-tag"><span class="std-dot"></span> {servico}</p>
      <h1>Recebemos suas <span class="serif-italic">respostas!</span></h1>
      <p class="obg-lede">Agora é só me chamar no WhatsApp para darmos o próximo passo.</p>
      <a href={waLink(mensagem)} class="btn btn-accent obg-btn" target="_blank" rel="noopener">
        <Icon name="whatsapp" size={22} /> Chamar no WhatsApp
      </a>
      <p class="obg-note">Abre o WhatsApp com uma mensagem pronta. É só enviar.</p>
    </div>
  </main>
</Base>

<style>
  .obg {
    padding: 128px 0 104px;
    min-height: 80svh;
    display: flex;
    align-items: center;
  }
  .obg-inner {
    max-width: 640px;
    text-align: center;
  }
  .obg-avatar {
    display: block;
    width: 96px;
    height: 96px;
    margin: 0 auto 20px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--accent);
  }
  .obg h1 {
    font-size: clamp(2.2rem, 7vw, 3.8rem);
    margin: 16px 0 12px;
  }
  .obg h1 .serif-italic {
    font-size: 1.06em;
  }
  .obg-lede {
    font-size: 1.15rem;
    color: var(--ink-2);
    margin: 0 auto 32px;
    max-width: 40ch;
  }
  .obg-btn {
    width: 100%;
    max-width: 420px;
    padding: 20px 28px;
    font-size: 1.08rem;
  }
  .obg-note {
    margin: 14px 0 0;
    font-size: 0.88rem;
    color: var(--ink-2);
  }
</style>
