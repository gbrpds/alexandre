---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Icon from './Icon.astro';
import { waLink } from '../config';

interface Props {
  servico: string;
  // Ex.: "questionário da Mentoria Vida Italiana na Prática"
  assunto: string;
}
const { servico, assunto } = Astro.props;
const mensagem = `Olá! Acabei de preencher o ${assunto}.`;
---
<Base title={`Obrigado | ${servico} | Vida Italiana na Prática`} description="Recebemos suas respostas." noindex semWhatsapp>
  <Header variant="solid" minimal />
  <main id="main" class="obg">
    <div class="container obg-inner">
      <img class="obg-avatar" src="/fotos/alexandre-avatar.jpg" alt="Alexandre" width="96" height="96" />
      <p class="std-tag"><span class="std-dot"></span> {servico}</p>
      <h1>Recebemos suas <span class="serif-italic">respostas!</span></h1>
      <p class="obg-lede" data-obg-lede>Agora é só me chamar no WhatsApp para darmos o próximo passo.</p>
      <a href={waLink(mensagem)} class="btn btn-accent obg-btn" data-obg-wa data-assunto={assunto}>
        <Icon name="whatsapp" size={22} /> Chamar no WhatsApp
      </a>
      <p class="obg-note" data-obg-note>Abre o WhatsApp com uma mensagem pronta. É só enviar.</p>
    </div>
  </main>
</Base>

<style>
  .obg {
    padding: 128px 0 104px;
    min-height: 80svh;
    display: flex;
    align-items: center;
  }
  .obg-inner {
    max-width: 640px;
    text-align: center;
  }
  .obg-avatar {
    display: block;
    width: 96px;
    height: 96px;
    margin: 0 auto 20px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--accent);
  }
  .obg h1 {
    font-size: clamp(2.2rem, 7vw, 3.8rem);
    margin: 16px 0 12px;
  }
  .obg h1 .serif-italic {
    font-size: 1.06em;
  }
  .obg-lede {
    font-size: 1.15rem;
    color: var(--ink-2);
    margin: 0 auto 32px;
    max-width: 40ch;
  }
  .obg-btn {
    width: 100%;
    max-width: 420px;
    padding: 20px 28px;
    font-size: 1.08rem;
  }
  .obg-note {
    margin: 14px 0 0;
    font-size: 0.88rem;
    color: var(--ink-2);
  }
</style>

<script>
  // Vindo do questionário do site: personaliza a mensagem com o nome e abre o WhatsApp sozinho.
  const params = new URLSearchParams(location.search);
  const wa = document.querySelector<HTMLAnchorElement>('[data-obg-wa]');
  if (wa && wa.href.includes('wa.me')) {
    const nome = (params.get('nome') || '').replace(/[^\p{L}\s'-]/gu, '').trim().slice(0, 40);
    if (nome) {
      const texto = `Olá, Alexandre! Sou ${nome} e acabei de preencher o ${wa.dataset.assunto}.`;
      wa.href = wa.href.split('?')[0] + '?text=' + encodeURIComponent(texto);
    }
    if (params.get('enviado') === '1') {
      document.querySelector('[data-obg-lede]')!.textContent = 'Estou abrindo o meu WhatsApp para você. Se não abrir, toque no botão abaixo.';
      document.querySelector('[data-obg-note]')!.textContent = 'A mensagem já vai pronta. É só enviar.';
      // Troca a URL para não reabrir o WhatsApp ao voltar para esta página.
      history.replaceState(null, '', location.pathname);
      setTimeout(() => (location.href = wa.href), 1500);
    }
  }
</script>
